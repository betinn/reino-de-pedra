# Exemplo de configuração do servidor (valores fictícios). Copie para .env (ignorado pelo git) ou exporte no ambiente.
# Pasta dos dados (banco SQLite)
REINO_DADOS=./dados
# Endereço de escuta do servidor
REINO_URLS=http://localhost:5080
# 1 = atrás de proxy reverso com HTTPS (aceita X-Forwarded-For/Proto)
REINO_PROXY=0
# Conexões abertas ao mesmo tempo por IP servindo direto (vazio = 100; 0 = sem limite; atrás de proxy fica desligado)
REINO_CONEXOES_IP=
# 1 = cookie de sessão também em HTTP (só para desenvolvimento local)
REINO_COOKIE_INSEGURO=1
# Semente do mapa ao criar um mundo novo (vazio = aleatória)
REINO_SEMENTE=
# Só desenvolvimento: o tempo do jogo corre N vezes mais rápido
REINO_ACELERACAO=1
# Só desenvolvimento: a temporada dura N minutos de jogo (vazio = P.temporadaDias)
REINO_TEMPORADA_MIN=
# 0 = não criar reinos de IA
REINO_IA=1
# Credencial das rotas do administrador (fila de convites). Vazia: as rotas não existem. Gere uma longa e aleatória; este valor é fictício.
REINO_ADMIN_TOKEN=troque-por-um-valor-longo-e-aleatorio
# Pedidos de convite por IP por hora (vazio = 5)
REINO_CONVITES_HORA=
# Só para scripts/convites.sh: endereço do jogo
REINO_SITE=http://localhost:5080
# 1 = falas dos reinos de IA reescritas por LLM (precisa de ANTHROPIC_API_KEY). Vazio ou 0: modelos de texto na voz de cada persona
REINO_FALAS_LLM=0
# Chave da API da Anthropic, só se REINO_FALAS_LLM=1. Nunca no repositório: deixe vazia aqui e ponha no .env ou no ambiente.
ANTHROPIC_API_KEY=
# Modelo das falas (vazio = claude-haiku-5-5)
REINO_FALAS_MODELO=
# Teto de falas por LLM por hora no mundo todo (vazio = 240); acima disso, modelos de texto
REINO_FALAS_HORA=
